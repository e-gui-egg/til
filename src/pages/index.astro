---
const title = "Hello, Astro!";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Astro で作る静的ブログ" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">My Astro Blog</p>
      <h1>{title}</h1>
      <p>静的ブログの準備ができました。</p>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    color: #20211f;
    font-family: system-ui, sans-serif;
    background: #f5f1e8;
  }
  main {
    width: min(42rem, calc(100% - 3rem));
    margin: 0 auto;
    padding: 8rem 0;
  }
  .eyebrow {
    color: #ac4b1c;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0.25rem 0 1rem;
    font-size: clamp(3rem, 10vw, 6rem);
    line-height: 0.95;
  }
</style>
