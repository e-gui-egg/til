---
import BaseLayout from "../layouts/BaseLayout.astro";
import IssueList from "../components/IssueList.astro";
import TagSidebar from "../components/TagSidebar.astro";
import { getIssues, getRepository, getTagCounts } from "../lib/github";

const issues = await getIssues();
const tags = getTagCounts(issues);
const repository = getRepository();
---

<BaseLayout>
  <div class="app-shell">
    <TagSidebar tags={tags} />
    <main id="content" class="feed">
      <header class="hero">
        <p>[ TECHNICAL_JOURNAL / {new Date().getFullYear()} ]</p>
        <h1>思考の断片を構造化し、<br />コードと共に記録する。</h1>
        <span>Source: <a href={`https://github.com/${repository}/issues`}>github.com/{repository}/issues</a></span>
      </header>
      <IssueList issues={issues} />
    </main>
  </div>
</BaseLayout>
