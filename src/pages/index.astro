---
import BaseLayout from "../layouts/BaseLayout.astro";
import IssueList from "../components/IssueList.astro";
import TagSidebar from "../components/TagSidebar.astro";
import { getIssues, getTagCounts } from "../lib/github";

const issues = await getIssues();
const tags = getTagCounts(issues);
---

<BaseLayout>
  <div class="app-shell">
    <TagSidebar tags={tags} />
    <main id="content" class="feed">
      <header class="hero">
        <h1>TODAY I LEARNED</h1>
      </header>
      <IssueList issues={issues} />
    </main>
  </div>
</BaseLayout>
