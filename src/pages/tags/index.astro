---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getIssues, getTagCounts } from "../../lib/github";
const tags = getTagCounts(await getIssues());
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<BaseLayout title="Labels">
  <main id="content" class="tag-index">
    <p class="kicker">[ LABEL_INDEX ]</p><h1>Labels / Tags</h1><p>GitHub Issue に付いた label が、そのまま記事のタグになります。</p>
    <div class="tag-grid">{tags.map(([tag, count]) => <a href={`${base}tags/${encodeURIComponent(tag)}/`}><span>#{tag}</span><strong>{count}</strong></a>)}</div>
  </main>
</BaseLayout>
